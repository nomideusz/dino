# Archive server
PORT=8080
ALLOWED_ORIGINS=https://dino.zaur.app,http://localhost:5173,http://localhost:5174,http://localhost:4173

# Optional but strongly recommended: with ANTHROPIC_API_KEY set, Claude acts
# as editor-in-chief (importance rating + calm 2-3 sentence summaries) and
# writes the dino's occasional thoughts. Without it a conservative heuristic
# picks stories and reuses the feeds' own descriptions.
# ANTHROPIC_API_KEY=

# Optional: NASA_API_KEY (APOD).
# Optional: ARCHIVE_PERSIST_PATH=/data/stories.json (survive redeploys).
